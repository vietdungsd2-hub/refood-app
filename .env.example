# Sao chép file này thành .env rồi chỉnh sửa
PORT=3000
NODE_ENV=development

# BẮT BUỘC đổi khi chạy thật. Tạo chuỗi ngẫu nhiên bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai

# Đường dẫn file SQLite (mặc định: data/refood.db)
# DB_FILE=./data/refood.db

# Đặt = 1 nếu chạy sau reverse proxy (Nginx, Render, Railway...)
# TRUST_PROXY=1

# Đặt = 1 để chặn đặt túi ngoài khung giờ mở bán của quán (mặc định chỉ hiển thị giờ, phù hợp bản demo)
# ENFORCE_SALE_WINDOW=1
